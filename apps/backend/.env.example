# Database
DATABASE_URL="postgresql://kss:kss_password@localhost:5432/kss_whatsapp?schema=public"

# Server
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN="http://localhost:5173"

# Auth
JWT_SECRET="change-this-to-a-long-random-secret"
JWT_EXPIRES_IN="8h"

# WhatsApp / Meta integration mode: "mock" or "live"
META_MODE=mock
META_APP_ID=""
META_APP_SECRET=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WEBHOOK_VERIFY_TOKEN="kss_webhook_verify_token"

# Public base URL of this server (used for media file links sent to Meta API)
# For local dev with ngrok: SERVER_BASE_URL="https://xxxx.ngrok-free.app"
# For production (Railway): SERVER_BASE_URL="https://your-app.railway.app"
SERVER_BASE_URL="http://localhost:4000"

# Supabase Storage — for media uploads (recommended, works on Vercel too)
# Use your existing Supabase project — just add SUPABASE_SERVICE_KEY (service_role key)
# Create a public bucket called "whatsapp-media" in Supabase Storage dashboard
SUPABASE_URL="https://xxxx.supabase.co"
SUPABASE_SERVICE_KEY=""          # Settings > API > service_role key (NOT anon key)
SUPABASE_STORAGE_BUCKET="whatsapp-media"

# Cloudinary — alternative to Supabase Storage (optional)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
