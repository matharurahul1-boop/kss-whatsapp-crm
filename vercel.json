{
  "version": 2,
  "buildCommand": "npm install && npx prisma generate --schema=apps/backend/prisma/schema.prisma && npm run build -w apps/frontend",
  "outputDirectory": "apps/frontend/dist",
  "functions": {
    "apps/backend/api/index.ts": {
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/apps/backend/api/index.ts" },
    { "source": "/webhook/(.*)", "destination": "/apps/backend/api/index.ts" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
