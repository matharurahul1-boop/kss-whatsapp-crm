{
  "version": 2,
  "builds": [
    {
      "src": "apps/backend/api/index.ts",
      "use": "@vercel/node"
    },
    {
      "src": "apps/frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist",
        "buildCommand": "npx prisma generate --schema=../backend/prisma/schema.prisma && npm run build"
      }
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "apps/backend/api/index.ts" },
    { "src": "/webhook/(.*)", "dest": "apps/backend/api/index.ts" },
    { "src": "/assets/(.*)", "dest": "/assets/$1" },
    { "src": "/sw.js", "dest": "/sw.js" },
    { "src": "/manifest.webmanifest", "dest": "/manifest.webmanifest" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
